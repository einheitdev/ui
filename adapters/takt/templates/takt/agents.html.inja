<section class="card">
  <h2 class="card-title">agents</h2>
  <div class="card-body">
{% if length(agents) > 0 %}
    <table class="data-table">
      <thead>
        <tr>
          <th>workspace</th>
          <th>name</th>
          <th>status</th>
          <th>model</th>
          <th class="right">turns</th>
          <th class="right">cost</th>
        </tr>
      </thead>
      <tbody>
{% for a in agents %}
        <tr>
          <td>{{ a.workspace }}</td>
          <td>{{ a.name }}</td>
          <td><span class="badge badge-{{ a.status_semantic }}">{{ a.status }}</span></td>
          <td>{{ a.model }}</td>
          <td class="right">{{ a.num_turns }}</td>
          <td class="right">{% if existsIn(a, "cost_usd") %}${{ a.cost_usd }}{% else %}—{% endif %}</td>
        </tr>
{% endfor %}
      </tbody>
    </table>
{% else %}
    <div class="empty">no active agents</div>
{% endif %}
  </div>
</section>
