<section class="card">
  <h2 class="card-title">workspaces</h2>
  <div class="card-body">
{% if length(workspaces) > 0 %}
    <table class="data-table">
      <thead>
        <tr>
          <th>name</th>
          <th>branch</th>
          <th>repos</th>
          <th class="right">count</th>
        </tr>
      </thead>
      <tbody>
{% for ws in workspaces %}
        <tr>
          <td><a href="/workspaces/{{ ws.name }}">{{ ws.name }}</a></td>
          <td>{{ ws.branch }}</td>
          <td>{{ ws.repos }}</td>
          <td class="right">{{ ws.repo_count }}</td>
        </tr>
{% endfor %}
      </tbody>
    </table>
{% else %}
    <div class="empty">no workspaces — create one with <code>workspace create</code></div>
{% endif %}
  </div>
</section>
